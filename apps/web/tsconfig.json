{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@zinc-pool/protocol": [
        "../../packages/protocol/src/index.ts"
      ],
      "@zinc-pool/*": [
        "../../packages/*/src/index.ts"
      ],
      "@zinc-pool/engine-physics": [
        "../../packages/engine-physics/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
